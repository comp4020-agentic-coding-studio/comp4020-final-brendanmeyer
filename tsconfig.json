{
  // Covers the supplied harness (spec/, scripts/) plus this app's own
  // server and shared code; the client has its own tsconfig.client.json
  // since it needs a real emit, not just type-checking.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true
  },
  "include": ["*.ts", "spec", "scripts", "src/server", "src/shared"]
}
