{
  // The browser can't strip types, so the client is the one part of this
  // app that needs a real build step: this emits plain ES modules to
  // dist/, loaded directly with <script type="module">, no bundler.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noEmit": false,
    "skipLibCheck": true,
    "moduleDetection": "force"
  },
  "include": ["src/client/**/*.ts", "src/shared/**/*.ts"]
}
